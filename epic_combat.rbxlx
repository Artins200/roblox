		<Item class="ModuleScript" referent="RBX000000000000000000000000000002B1">
			<Properties>
				<string name="Name">CombatConfig</string>
				<ProtectedString name="Source"><![CDATA[--[[
	CombatConfig — все настройки боевой системы в одном месте.

	НАБОР БОЙЦА (4 атаки + полёт):
	  ЛКМ   — КОМБО из 4 ударов (рукопашка)
	  F     — ПИНОК-ЛОНЧЕР (подбрасывает врага)
	  R     — ЛАЗЕР (мощный луч)
	  X     — УЛЬТА «ОБЛИТЕРАЦИЯ» (копится за урон)
	  V     — ПОЛЁТ

	Хочешь свои анимации из Toolbox — впиши их ID в Config.ToolboxAnims,
	для этих действий процедурные позы отключатся и будут играть треки.
]]

local Config = {}

Config.Build = "epic-combat-2"

-- ---------------------------------------------------------------------------
-- Боец
-- ---------------------------------------------------------------------------
Config.Fighter = {
	health        = 2500,
	walkSpeed     = 22,
	sprintSpeed   = 32,
	jumpPower     = 52,
	koTime        = 4,       -- задержка респавна
	regenDelay    = 6,       -- через сколько секунд без урона начинается реген
	regenPerSecond = 45,
	spawnProtect  = 1.5,     -- секунд неуязвимости после респавна
}

-- Энергия (тратится на атаки, сама восстанавливается)
Config.Energy = {
	max   = 100,
	regen = 26,
}

-- Шкала ульты: копится за нанесённый и полученный урон + понемногу сама
Config.Ult = {
	max              = 100,
	passive          = 1.8,   -- в секунду
	perDamageDealt   = 0.06,  -- множитель нанесённого урона
	perDamageTaken   = 0.035, -- множитель полученного урона
}

-- ---------------------------------------------------------------------------
-- ЧЕТЫРЕ АТАКИ
-- ---------------------------------------------------------------------------
Config.Abilities = {
	punch = { name = "КОМБО",   key = "ЛКМ", cooldown = 0.24, energy = 0,
	          hint = "ЛКМ — комбо из 4 ударов (можно зажать)" },
	kick  = { name = "ПИНОК",   key = "F",   cooldown = 2.6,  energy = 14,
	          hint = "F — пинок-лончер: подбрасывает врага в воздух" },
	laser = { name = "ЛАЗЕР",   key = "R",   cooldown = 3.4,  energy = 26,
	          hint = "R — плазменный луч на 800 стадов" },
	ult   = { name = "УЛЬТА",   key = "X",   cooldown = 1.0,  energy = 0,
